		//  Declaración global
		ArregloMatricula am = new ArregloMatricula();
		
		public void actionPerformed(ActionEvent e) {
			if (e.getSource() == btnBuscar) {
				actionPerformedBtnBuscar(e);
			}
			if (e.getSource() == btnOK) {
				actionPerformedBtnOK(e);
			}
			if (e.getSource() == btnMatricular) {
				actionPerformedBtnMatricular(e);
			}
			if (e.getSource() == btnModificar) {
				actionPerformedBtnModificar(e);
			}
			if (e.getSource() == btnEliminar) {
				actionPerformedBtnEliminar(e);
			}
			if (e.getSource() == btnRegresar) {
				actionPerformedBtnRegresar(e);
			}
		}
		
		protected void actionPerformedBtnBuscar(ActionEvent e) {	
			buscarMatricula();
			
		}
		
		protected void actionPerformedBtnOK(ActionEvent e) {
			switch (tipoRegresar) {
			case MATRICULAR:
				 txtCodigoAlumno.setEditable(true);
				adicionarMatricula();
				break;
			case MODIFICAR:
				modificarMatricula();
				cboCurso.setEnabled(false);
				break;
			case ELIMINAR:
				eliminarMatricula();
				
			}
		}
		
		protected void actionPerformedBtnMatricular(ActionEvent e) {
			 cboCurso.setSelectedIndex(0);
			 tipoRegresar = MATRICULAR;
				cboCurso.setEnabled(true);
			    txtCodigoAlumno.setText("" + am.codigoCorrelativo());
			    txtCodigoMatricula.setText("" + am.codigoCorrelativoMatri());
			    habilitarBotones(false);
			
			
		}	
		
		protected void actionPerformedBtnModificar(ActionEvent e) {		
			 tipoRegresar = MODIFICAR;
			 txtCodigoAlumno.setEditable(true);
			 habilitarBotones(false);
		}	
		
		
		protected void actionPerformedBtnEliminar(ActionEvent e) {	
			 tipoRegresar = ELIMINAR;
			 txtCodigoAlumno.setEditable(true);
			 habilitarBotones(false);
			 cboCurso.setEnabled(false);
			 cboCurso.setEditable(false);
		}	
		
		
		
		
		
		protected void actionPerformedBtnRegresar(ActionEvent e) {	
			txtCodigoAlumno.setText("");
			txtCodigoMatricula.setText("");
			txtCodigoAlumno.setEditable(false);
			cboCurso.setEnabled(false);
			habilitarEntradas(false);
			habilitarBotones(true);
		}
		
		
		
		
		
		
	//  Métodos tipo void (sin parámetros)
		void ajustarAnchoColumnas() {
			TableColumnModel tcm = tblMatricular.getColumnModel();
			tcm.getColumn(0).setPreferredWidth(anchoColumna(10)); // codigo matricula
			tcm.getColumn(1).setPreferredWidth(anchoColumna(10)); // codigo alumno
			tcm.getColumn(2).setPreferredWidth(anchoColumna(10)); // codigo curso
		}
		
		
		
		
		
		void listar() {
			Matricula x;
			modelo.setRowCount(0);
			for (int i=0; i<am.tamanio(); i++) {
				x = am.obtener(i);
				Object[] fila = { x.getCodigoMatricula(),
								  x.getCodigoAlumno(),
								  x.getCodigoCurso() };
				modelo.addRow(fila);
			}
		}
		
		
		
		
		
		//TODO BIEN ADICIONAR CON MATRICULAR 
		
		void adicionarMatricula() {
			
			int codigoMatricula = leerCodigoMatricula();
		    if (codigoMatricula > 0) {
		        int codigoAlumno = leerCodigoAlumno();
		        if (codigoAlumno > 0) {
		            if (am.buscar(codigoAlumno) == null) {
		            	String codigoCurso = enTextoCurso(leerCodigoCurso()); // Obtener el texto del JComboBox
		                Matricula nueva = new Matricula(codigoMatricula, codigoAlumno, Integer.parseInt(codigoCurso));
		                am.adicionar(nueva);
		                listar();
		                txtCodigoMatricula.setText("" + am.codigoCorrelativoMatri());
		                txtCodigoAlumno.setText("" + am.codigoCorrelativo());
		                txtCodigoMatricula.requestFocus();
		            } else {
		                error("El código de alumno ya existe", txtCodigoMatricula);
		            }
		        } else {
		            error("Ingrese un código de matrícula válido", txtCodigoAlumno);
		        }
		    } else {
		        error("Ingrese un código de alumno válido", txtCodigoMatricula);
		    }
		}
		
		
		
		
		
		
		
		void modificarMatricula() {
			 try {
			        int codigoMatricula = leerCodigoMatricula();
			        Matricula x = am.buscar(codigoMatricula);

			        if (x != null) {
			            int codigoAlumno = leerCodigoAlumno();
			            if (codigoAlumno > 0) {
			                // Obtiene el texto seleccionado del JComboBox en lugar del índice
			                String codigoCurso = enTextoCurso(leerCodigoCurso());

			                x.setCodigoAlumno(codigoAlumno);
			                x.setCodigoCurso(Integer.parseInt(codigoCurso)); // Convertir el código de curso a entero

			                // Buscar la fila correspondiente en la tabla y actualizar sus valores
			                for (int i = 0; i < modelo.getRowCount(); i++) {
			                    if (Integer.parseInt(modelo.getValueAt(i, 0).toString()) == codigoMatricula) {
			                        modelo.setValueAt(codigoCurso, i, 2);
			                        break; // Una vez encontrado, salir del bucle
			                    }
			                }

			                // Limpiar campos después de modificar
			                
			                limpiarCampos();
			            } else {
			                error("Ingrese un código de matrícula válido", txtCodigoAlumno);
			            }
			        } else {
			            error("El código de alumno " + codigoMatricula + " no existe", txtCodigoMatricula);
			        }
			    } catch (Exception e) {
			        error("Por favor complete la casilla de codigo Alumno", txtCodigoMatricula);
			    }
	
		}
		
		
		
		
		
		
		void buscarMatricula() {
			try {
		        // Paso 1: Leer el código de alumno
		        int codigoAlumno = leerCodigoAlumno();

		        // Paso 2: Buscar la matrícula asociada al código de alumno
		        Matricula matricula = am.buscarAlumno(codigoAlumno); 
		           

		        if (matricula != null) {
		            // Paso 3: Mostrar la información encontrada
		            txtCodigoMatricula.setText(String.valueOf(matricula.getCodigoMatricula()));
		            cboCurso.setSelectedItem(String.valueOf(matricula.getCodigoCurso()));

		            // Paso 4: Habilitar la edición del cboCurso
		            cboCurso.setEnabled(true);

		            // Paso 5: Deshabilitar el botón "Buscar"
		            btnBuscar.setEnabled(true);
		         
		            // Paso adicional: Activar el botón "OK"
		            btnOK.setEnabled(true);
		            
		            
		            if(tipoRegresar == ELIMINAR) {
		            	cboCurso.setEnabled(false);
		            }
		           
		           
		        } else {
		            // Si no se encuentra la matrícula, mostrar un mensaje de error
		            error("No se encontró ninguna matrícula para el código de alumno proporcionado", txtCodigoAlumno);
		        }
		    } catch (NumberFormatException e) {
		        // Manejar la excepción si el código de alumno no es un número
		        error("Ingrese un código de alumno válido", txtCodigoAlumno);
		    }
			
			
		}
		
		
		
		
		void eliminarMatricula() {
			try {
				 
				
		        int codigo = leerCodigoMatricula();
		        Matricula x = am.buscar(codigo);
		       
		         
		        if (x != null) {
		        	
		        	
		            // Mostrar los datos correspondientes
		            mostrarDatosMatricula(x);
		            
		        } else {
		            error("El código " + codigo + " no existe", txtCodigoMatricula);
		        }
		       

		    } catch (Exception e) {
		        error("Ingrese CÓDIGO correcto", txtCodigoMatricula);
		    }
		}
		
		
		
		
		void mostrarDatosMatricula(Matricula matricula) {
		    String mensaje = "Datos de la matrícula a eliminar:\n"
		            + "Código de Matrícula: " + matricula.getCodigoMatricula() + "\n"
		            + "Código de Alumno: " + matricula.getCodigoAlumno() + "\n"
		            + "Código de Curso: " + matricula.getCodigoCurso() + "\n";

		    // Mostrar el mensaje con los datos
		    int confirmacion = confirmar(mensaje + "¿Está seguro de eliminar la matrícula?");
		   
		    // Si elige "No", cancelar la operación de eliminar
		    if (confirmacion == 0) {
		        btnOK.setEnabled(true);
		      	am.eliminar(matricula);
			    listar();
			        	limpiarCampos();
			        	  btnOK.setEnabled(false);
			        	  cboCurso.setEnabled(false);
		    }
		        else 
		        	btnOK.setEnabled(true);
		        
		    
		}
		
	 
		
		
		
		
		void limpiarCampos() {
		    // Limpiar los campos que deseas al presionar el botón OK
		    txtCodigoMatricula.setText("");
		    txtCodigoAlumno.setText("");
		    cboCurso.setSelectedIndex(-1);
		}
		
		
		
		
		
		//  Métodos tipo void (con parámetros)
		void habilitarEntradas(boolean sino) {
			txtCodigoMatricula.setEditable(sino);
			if (tipoRegresar == MATRICULAR)
			cboCurso.setEnabled(sino);
		}
		void habilitarBotones(boolean sino) {
			if (tipoRegresar == MATRICULAR)
				btnOK.setEnabled(!sino);
			else {
				btnBuscar.setEnabled(!sino);
				btnOK.setEnabled(false);
			}
			btnMatricular.setEnabled(sino);
			btnModificar.setEnabled(sino);
			btnEliminar.setEnabled(sino);
			btnRegresar.setEnabled(!sino);
		}
		
		
		
		
		
		
		
		void mensaje(String s) {
			JOptionPane.showMessageDialog(this, s, "Información", 0);
		}
		void error(String s, JComponent component) {
			 mensaje(s);
			    if (component instanceof JTextField) {
			        JTextField txt = (JTextField) component;
			        txt.setText("");
			        txt.requestFocus();
			    } else if (component instanceof JComboBox) {
			        JComboBox<?> cbo = (JComboBox<?>) component;
			        cbo.setSelectedIndex(-1);
			        cbo.requestFocus();
			    }
		}
		
		
		
		//  Métodos que retornan valor (sin parámetros)
		int leerCodigoMatricula() {
			return Integer.parseInt(txtCodigoMatricula.getText().trim());
		}
		int leerCodigoAlumno() {
			return Integer.parseInt(txtCodigoAlumno.getText().trim());
		}
		int leerCodigoCurso() {
			return cboCurso.getSelectedIndex();
		}
		//  Métodos que retornan valor (con parámetros)
		int anchoColumna(int porcentaje) {
			return porcentaje * scrollPane.getWidth() / 100;
		}
		String enTextoCurso(int i) {
			return cboCurso.getItemAt(i);
		}
		int confirmar(String s) {
			return JOptionPane.showConfirmDialog(this, s, "Alerta", 0, 1, null);
		}
		
