	//Declaración global
	ArregloAlumno aa = new ArregloAlumno();
	ArregloCurso ac = new ArregloCurso();
	ArregloMatricula am = new ArregloMatricula();
	
	public void actionPerformed(ActionEvent e) {
		if (e.getSource() == btnBuscar) {
			actionPerformedBtnBuscar(e);
		}
		if (e.getSource() == btnBorrar) {
			actionPerformedBtnBorrar(e);
		}
	}
	
	
	
	protected void actionPerformedBtnBuscar(ActionEvent e) {
	
	}
	
	protected void actionPerformedBtnBorrar(ActionEvent e) {	
		txtResultado.setText("");
	}
	
	
	//M�todos tipo void (sin par�metros)
		void imprimir(){
			imprimir("");
		}
		
		
		void listar() {
		    // Limpiar el resultado anterior
		    txtResultado.setText("");

		    // Obtener el código del alumno ingresado
		    int codigoAlumno = leerCodigoAlumno();

		    // Buscar y mostrar las matrículas del alumno
		    ArrayList<Matricula> matriculas = am.obtenerMatriculasPorAlumno(codigoAlumno);
		    if (!matriculas.isEmpty()) {
		        imprimir("Matrículas del Alumno:");
		        imprimir("------------------------------------------------------");
		        imprimir(String.format("%-15s%-20s", "Código del Curso", "Nombre del Curso"));
		        imprimir("------------------------------------------------------");

		        // Mostrar detalles de cada matrícula
		        for (Matricula matricula : matriculas) {
		            Curso curso = ac.buscar(matricula.getCodigoCurso());
		            if (curso != null) {
		                imprimir(String.format("%-15s%-20s",
		                        curso.getCodigoCurso(),
		                        curso.getAsignatura()));
		            }
		        }
		    } else {
		        // Si no hay matrículas para el alumno
		        imprimir("El alumno no está matriculado en ningún curso.");
		        // Aquí también puedes mostrar los datos del alumno si lo deseas
		        Alumno alumno = aa.buscar(codigoAlumno);
		        if (alumno != null) {
		            imprimir("Datos del Alumno:");
		            imprimir("------------------------------------------------------");
		            imprimir(String.format("%-15s%-20s%-20s%-15s", "Código", "Nombre", "Apellido", "DNI"));
		            imprimir("------------------------------------------------------");
		            imprimir(String.format("%-15s%-20s%-20s%-15s",
		                    alumno.getCodigoAlumno(),
		                    alumno.getNombre(),
		                    alumno.getApellido(),
		                    alumno.getDni()));
		        }
		    }
		}
		
		//M�todos tipo void (con par�metros)
		void imprimir(String s){
			txtResultado.append(s + "\n"); 
		}
		void mensaje(String s) {
			JOptionPane.showMessageDialog(this, s, "Informaci�n", 0);
		}
		void error(String s, JTextField txt) {
			mensaje(s);
			txt.setText("");
			txt.requestFocus();
		}
		//M�todos que retornan valor
		int leerCodigoAlumno(){
			return Integer.parseInt(txtCodigoAlumno.getText().trim());
		}
