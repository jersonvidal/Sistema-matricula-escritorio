	// Declaracion global
	ArregloAlumno al = new ArregloAlumno();
	
	public void actionPerformed(ActionEvent e) {
		if (e.getSource() == btnBuscar) {
			actionPerformedBtnBuscar(e);
		}
		if (e.getSource() == btnOK) {
			actionPerformedBtnOK(e);
		}
		if (e.getSource() == btnIngresar) {
			actionPerformedBtnIngresar(e);
		}
		if (e.getSource() == btnModificar) {
			actionPerformedBtnModificar(e);
		}
		if (e.getSource() == btnConsultar) {
			actionPerformedBtnConsultar(e);
		}
		if (e.getSource() == btnEliminar) {
			actionPerformedBtnEliminar(e);
		}
		if (e.getSource() == btnRegresar) {
			actionPerformedBtnRegresar(e);
		}
	}
	
	protected void actionPerformedBtnBuscar(ActionEvent e) {
		consultarAlumno();
	}
	protected void actionPerformedBtnOK(ActionEvent e) {
		switch (tipoRegresar) {
		case INGRESAR:
			ingresarAlumno();
			break;
		case MODIFICAR:
			modificarAlumno();
			break;
		case CONSULTAR:
			consultarAlumno();
			break;
		case ELIMINAR:
			eliminarAlumno();
		}
	}
	protected void actionPerformedBtnIngresar(ActionEvent e) {
		tipoRegresar = INGRESAR;
		txtCodigo.setText("" + al.codigoCorrelativo());
		habilitarEntradas(true);
		habilitarBotones(false);
		txtNombre.requestFocus();
	}
	protected void actionPerformedBtnModificar(ActionEvent e) {
		tipoRegresar = MODIFICAR;
		txtCodigo.setEditable(true);
		habilitarBotones(false);
		txtCodigo.requestFocus();
	}
	protected void actionPerformedBtnConsultar(ActionEvent e) {
		tipoRegresar = CONSULTAR;
		txtCodigo.setEditable(true);
		habilitarBotones(false);
		txtCodigo.requestFocus();
	}
	protected void actionPerformedBtnEliminar(ActionEvent e) {
		tipoRegresar = ELIMINAR;
		txtCodigo.setEditable(true);
		habilitarBotones(false);
		txtCodigo.requestFocus();
	}
	protected void actionPerformedBtnRegresar(ActionEvent e) {
		txtCodigo.setText("");
		txtNombre.setText("");
		txtApellido.setText("");
		txtTelefono.setText("");
		txtDni.setText("");
		txtCodigo.setEditable(false);
		habilitarEntradas(false);
		habilitarBotones(true);
	}
	//  Métodos tipo void (sin parámetros)
	void ajustarAnchoColumnas() {
		TableColumnModel tcm = tblAlumno.getColumnModel();
		tcm.getColumn(0).setPreferredWidth(anchoColumna(8)); // codigo
		tcm.getColumn(1).setPreferredWidth(anchoColumna(18)); // nombres
		tcm.getColumn(2).setPreferredWidth(anchoColumna(18)); // apellidos
		tcm.getColumn(3).setPreferredWidth(anchoColumna(10)); // telefono
		tcm.getColumn(4).setPreferredWidth(anchoColumna(10)); // dni
	}
	void listar() {
		Alumno x;
		modelo.setRowCount(0);
		for (int i=0; i<al.tamanio(); i++) {
			x = al.obtener(i);
			Object[] fila = { x.getCodigoAlumno(),
							  x.getNombre(),
							  x.getApellido(),
							  x.getTelefono(),
							  x.getDni() };
			modelo.addRow(fila);
		}
	}
	
	
	void ingresarAlumno() {
	    int codigo = leerCodigoAlumno();
	    String nombre = leerNombre();
	    if (nombre.length() > 0) {
	        String apellido = leerApellido();
	        if (apellido.length() > 0) {
	            String telefono = leerTelefono();
	            if (telefono.length() > 0) {
	                String dni = leerDni();
	                if (dni.length() > 0) {
	                    if (al.buscar(Integer.parseInt(dni)) == null) {
	                        Alumno nueva = new Alumno(codigo, nombre, apellido, telefono, dni);
	                        al.adicionar(nueva);
	                        listar();
	                        txtCodigo.setText("" + al.codigoCorrelativo());
	                        txtNombre.setText("");
	                        txtApellido.setText("");
	                        txtTelefono.setText("");
	                        txtDni.setText("");
	                        txtNombre.requestFocus();
	                    } else {
	                        error("El DNI " + dni + " ya existe", txtDni);
	                    }
	                } else {
	                    error("Ingrese un DNI correcto", txtDni);
	                }
	            } else {
	                error("Ingrese un teléfono válido", txtTelefono);
	            }
	        } else {
	            error("Ingrese un apellido correcto", txtApellido);
	        }
	    } else {
	        error("Ingrese un nombre correcto", txtNombre);
	    }
	}
	
	
	
	void modificarAlumno() {
	    try {
	        int codigo = leerCodigoAlumno();
	        Alumno x = al.buscar(codigo);
	        if (x != null) {
	            String nombre = leerNombre();
	            if (nombre.length() > 0) {
	                String apellido = leerApellido();
	                if (apellido.length() > 0) {
	                    String telefono = leerTelefono();
	                    if (telefono.length() > 0) {
	                        x.setNombre(nombre);
	                        x.setApellido(apellido);
	                        x.setTelefono(telefono);
	                        listar();
	                        txtNombre.requestFocus();
	                        
	                        limpiarCampos();
	                        habilitarEntradas(false);

	                        // Habilitar el botón Buscar y deshabilitar el botón OK
	                        btnBuscar.setEnabled(true);
	                        txtApellido.setEditable(false);
	                        txtCodigo.setEditable(true);
	                        btnOK.setEnabled(false);
	                    } else {
	                        error("Ingrese un teléfono válido", txtTelefono);
	                    }
	                } else {
	                    error("Ingrese un apellido correcto", txtApellido);
	                }
	            } else {
	                error("Ingrese un nombre correcto", txtNombre);
	            }
	        } else {
	            error("El código " + codigo + " no existe", txtCodigo);
	        }
	    } catch (Exception e) {
	        error("Ingrese un código correcto", txtCodigo);
	    }
	}
	
	
	
	
	void consultarAlumno() {
	    try {
	        int codigo = leerCodigoAlumno();
	        Alumno x = al.buscar(codigo);
	        if (x != null) {
	            txtNombre.setText(x.getNombre());
	            txtApellido.setText(x.getApellido());
	            txtTelefono.setText(x.getTelefono());
	            txtDni.setText(x.getDni());
	            if (tipoRegresar == MODIFICAR) {
	                habilitarEntradas(true);
	                txtDni.setEditable(false);
	                txtApellido.setEditable(true);
	                txtCodigo.setEditable(false);
	                btnBuscar.setEnabled(false);
	                btnOK.setEnabled(true);
	                txtCodigo.requestFocus();
	            }
	            if (tipoRegresar == ELIMINAR) {
	                txtCodigo.setEditable(false);
	                btnBuscar.setEnabled(false);
	                btnOK.setEnabled(true);
	            }
	        } else {
	            error("El código " + codigo + " no existe", txtCodigo);
	        }
	    } catch (Exception e) {
	        error("Ingrese CÓDIGO correcto", txtCodigo);
	    }
	}
	
	
	void eliminarAlumno() {
	    try {
	        int codigo = leerCodigoAlumno();
	        Alumno x = al.buscar(codigo);
	        if (x != null) {
	            int confirmacion = confirmar("¿Desea eliminar el registro?");
	            if (confirmacion == 0) {
	                al.eliminar(x);
	                listar();
	                limpiarCampos();
	                btnOK.setEnabled(false);
	            }
	        } else {
	            error("El código " + codigo + " no existe", txtCodigo);
	        }
	    } catch (Exception e) {
	        error("Ingrese CÓDIGO correcto", txtCodigo);
	    }
	}
	
	
	
	void limpiarCampos() {
	    // Limpiar los campos que deseas al presionar el botón OK
	    txtCodigo.setText("");
	    txtNombre.setText("");
	    txtApellido.setText("");
	    txtTelefono.setText("");
	    txtDni.setText("");
	}
	//  Métodos tipo void (con parámetros)
	void habilitarEntradas(boolean sino) {
		txtNombre.setEditable(sino);
		if (tipoRegresar == INGRESAR)
			txtApellido.setEditable(sino);
		txtTelefono.setEditable(sino);
		txtDni.setEditable(sino);
	}
	void habilitarBotones(boolean sino) {
		if (tipoRegresar == INGRESAR)
			btnOK.setEnabled(!sino);
		else {
			btnBuscar.setEnabled(!sino);
			btnOK.setEnabled(false);
		}	
		btnIngresar.setEnabled(sino);
		btnModificar.setEnabled(sino);
		btnConsultar.setEnabled(sino);
		btnEliminar.setEnabled(sino);
		btnRegresar.setEnabled(!sino);
	}
	void mensaje(String s) {
		JOptionPane.showMessageDialog(this, s, "Información", 0);
	}
	void error(String s, JTextField txt) {
		mensaje(s);
		txt.setText("");
		txt.requestFocus();
	}
	//  Métodos que retornan valor (sin parámetros)
	int leerCodigoAlumno() {
		return Integer.parseInt(txtCodigo.getText().trim());
	}
	String leerNombre() {
		return txtNombre.getText().trim();
	}
	String leerApellido() {
		return txtApellido.getText().trim();
	}
	String leerTelefono() {
		return txtTelefono.getText().trim();
	}
	String leerDni() {
		return txtDni.getText().trim();
	}
	//  Métodos que retornan valor (con parámetros)
	int anchoColumna(int porcentaje) {
		return porcentaje * scrollPane.getWidth() / 100;
	}
	double ajustar(double numero) {
		return (int)(numero * 10) / 10.0;
	}
	int confirmar(String s) {
		return JOptionPane.showConfirmDialog(this, s, "Alerta", 0, 1, null);
	}
}
