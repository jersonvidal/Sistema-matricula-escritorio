	//  Métodos tipo void (sin parámetros)
		void ajustarAnchoColumnas() {
			TableColumnModel tcm = tblMatricular.getColumnModel();
			tcm.getColumn(0).setPreferredWidth(anchoColumna(10)); // codigo matricula
			tcm.getColumn(1).setPreferredWidth(anchoColumna(10)); // codigo alumno
			tcm.getColumn(2).setPreferredWidth(anchoColumna(10)); // codigo curso
		}
		void listar() {
			Matricula x;
			modelo.setRowCount(0);
			for (int i=0; i<am.tamanio(); i++) {
				x = am.obtener(i);
				Object[] fila = { x.getCodigoMatricula(),
								  x.getCodigoAlumno(),
								  x.getCodigoCurso() };
				modelo.addRow(fila);
			}
		}
		
	
		
