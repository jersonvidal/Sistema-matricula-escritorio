		void limpiarCampos() {
		    // Limpiar los campos que deseas al presionar el botón OK
		    txtCodigoMatricula.setText("");
		    txtCodigoAlumno.setText("");
		    cboCurso.setSelectedIndex(-1);
		}
		//  Métodos tipo void (con parámetros)
		void habilitarEntradas(boolean sino) {
			txtCodigoMatricula.setEditable(sino);
			if (tipoRegresar == MATRICULAR)
			cboCurso.setEnabled(sino);
		}
		void habilitarBotones(boolean sino) {
			if (tipoRegresar == MATRICULAR)
				btnOK.setEnabled(!sino);
			else {
				btnBuscar.setEnabled(!sino);
				btnOK.setEnabled(false);
			}
			btnMatricular.setEnabled(sino);
			btnModificar.setEnabled(sino);
			btnEliminar.setEnabled(sino);
			btnRegresar.setEnabled(!sino);
		}
		void mensaje(String s) {
			JOptionPane.showMessageDialog(this, s, "Información", 0);
		}
		void error(String s, JComponent component) {
			 mensaje(s);
			    if (component instanceof JTextField) {
			        JTextField txt = (JTextField) component;
			        txt.setText("");
			        txt.requestFocus();
			    } else if (component instanceof JComboBox) {
			        JComboBox<?> cbo = (JComboBox<?>) component;
			        cbo.setSelectedIndex(-1);
			        cbo.requestFocus();
			    }
		}
