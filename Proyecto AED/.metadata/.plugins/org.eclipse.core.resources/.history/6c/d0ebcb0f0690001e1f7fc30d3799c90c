package arreglos;

import java.io.*;
import java.util.ArrayList;
import clases.Curso;



public class ArregloCurso {
    private ArrayList<Curso> cursos;

    public ArregloCurso() {
        cursos = new ArrayList<>();
        cargarCursos();
    }

    public void adicionar(Curso x) {
        cursos.add(x);
        grabarCursos();
    }

    public void eliminar(Curso x) {
        cursos.remove(x);
        grabarCursos();
    }

    public int tamanio() {
        return cursos.size();
    }

    public Curso obtener(int i) {
        return cursos.get(i);
    }

    public Curso buscar(int codigo) {
        for (int i = 0; i < cursos.size(); i++) {
            if (cursos.get(i).getCodigoCurso() == codigo)
                return cursos.get(i);
        }
        return null;
    }

    public int codigoCorrelativo() {
        if (cursos.isEmpty()) return 3001;
        return cursos.get(cursos.size() - 1).getCodigoCurso() + 1;
    }

    public void actualizarArchivo() {
        grabarCursos();
    }

    private void grabarCursos() {
        try (PrintWriter pw = new PrintWriter(new FileWriter("cursos.txt"))) {
            for (Curso x : cursos) {
                String linea = x.getCodigoCurso() + ";" +
                        x.getCodigoDocente() + ";" +
                        x.getNombre() + ";" +
                        x.getHora();
                pw.println(linea);
            }
        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    private void cargarCursos() {
        try (BufferedReader br = new BufferedReader(new FileReader("cursos.txt"))) {
            String linea;
            while ((linea = br.readLine()) != null) {
                String[] s = linea.split(";");
                int codCurso = Integer.parseInt(s[0].trim());
                int codDocente = Integer.parseInt(s[1].trim());
                String nombre = s[2].trim();
                int horas = Integer.parseInt(s[3].trim());
                Curso curso = new Curso(codCurso, codDocente, nombre, horas);
                if (curso != null) {
                    adicionar(curso);
                }
            }
        } catch (Exception e) {
            e.printStackTrace();
        }
    }
}