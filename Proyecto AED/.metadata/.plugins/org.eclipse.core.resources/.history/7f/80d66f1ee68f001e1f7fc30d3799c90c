	}

	//METODO LISTADO
	void listar() {
		Docente x;
		modelo.setRowCount(0);
		for (int i=0; i<ad.tamanio(); i++) {
			x = ad.obtener(i);
			Object[] fila = { x.getCodigoDocente(),
					          x.getNombre(),
					          x.getApellido(),
					          x.getCategoria(),
					          x.getTelefono(),
					          x.getDni()};
					          
			modelo.addRow(fila);
		}
	}
	
	/// MÉTODO ADICIONAR
	void ingresarDocente() {
	    int codigoDocente = leerCodigo();
	    String nombre = leerNombre();
	    
	    if (nombre.length() > 0) {
	        String apellido = leerApellido();
	        
	        if (apellido.length() > 0) {
	            String categoria = leerCategoria(); 
	            
	            if (categoria.length() > 0) {
	                String telefono = leerTelefono();
	                
	                if (telefono.length() > 0) {
	                    String dni = leerDni(); 
	                    
	                    if (dni.length() > 0)  {
	                        if (ad.buscar(codigoDocente) == null) {  // Modificado para buscar por códigoDocente
	                            Docente nueva = new Docente(codigoDocente, nombre, apellido, categoria, telefono, dni);
	                            ad.adicionar(nueva);
	                            
	                            txtCodigo.setText("" + ad.codigoCorrelativo());
	                            txtNombreDocente.setText("");
	                            txtApellido.setText("");
	                            txtCategoria.setText("");
	                            txtTelefono.setText("");
	                            txtDni.setText("");
	                            listar();
	                            txtNombreDocente.requestFocus();
	                        }	
	                        else {
	                            error("El código " + codigoDocente + " ya existe", txtCodigo);
	                        }	
	                    }	
	                    else {
	                        error("Ingrese un DNI correcto", txtDni);
	                    }			
	                }	
	                else {
	                    error("Ingrese un TELÉFONO correcto", txtTelefono);
	                }			
	            }		
	            else {
	                error("Ingrese una CATEGORÍA correcta", txtCategoria);
	            }		
	        }
	        else {
	            error("Ingrese un APELLIDO correcto", txtApellido);
	        }		
	    }
	    else {
	        error("Ingrese NOMBRE correcto", txtNombreDocente);
	    }			
	}
		
		
		
	// MÉTODO CONSULTAR
	void consultarPersona() {
	    try {
	        int codigo = leerCodigo();
	        Docente x = ad.buscar(codigo);

	        if (x != null) {
	            txtNombreDocente.setText(x.getNombre());
	            txtApellido.setText(x.getApellido());
	            txtCategoria.setText(x.getCategoria());
	            txtTelefono.setText(x.getTelefono());
	            txtDni.setText(x.getDni());

	            if (tipoOperaciones == MODIFICAR) {
	                habilitarEntradas(true);
	                txtApellido.setEditable(true);
	                txtDni.setEditable(false);
	                txtCodigo.setEditable(false);
	                btnBuscar.setEnabled(false);
	                btnOK.setEnabled(true);
	                txtNombreDocente.requestFocus();
	            }

	            if (tipoOperaciones == ELIMINAR) {
	                txtCodigo.setEditable(false);
	                btnBuscar.setEnabled(false);
	                btnOK.setEnabled(true);
	            }
	        } else {
	            error("El código " + codigo + " no existe", txtCodigo);
	        }
	    } catch (Exception e) {
	        error("Ingrese CÓDIGO correcto", txtCodigo);
	    }
	}
		
		
		
	// Método MODIFICAR
	void modificarPersona() {
	    try {
	        int codigo = leerCodigo();
	        Docente x = ad.buscar(codigo);

	        if (x != null) {
	            String nombre = leerNombre();
	            if (nombre.length() > 0) {
	                String apellido = leerApellido();
	                if (apellido.length() > 0) {
	                    String categoria = leerCategoria();
	                    if (categoria.length() > 0) {
	                        String telefono = leerTelefono();
	                        if (telefono.length() > 0) {

	                            x.setNombre(nombre);
	                            x.setApellido(apellido);
	                            x.setCategoria(categoria);
	                            x.setTelefono(telefono);
	                            listar();
	                            txtNombreDocente.requestFocus();

	                            limpiarCampos();
	                            habilitarEntradas(false);

	                            // Habilitar el botón Buscar y deshabilitar el botón OK
	                            btnBuscar.setEnabled(true);
	                            txtApellido.setEditable(false);
	                            txtCodigo.setEditable(true);
	                            btnOK.setEnabled(false);

	                        } else {
	                            error("Ingrese un Teléfono correcto", txtTelefono);
	                        }
	                    } else {
	                        error("Ingrese una CATEGORÍA correcta", txtCategoria);
	                    }
	                } else {
	                    error("Ingrese APELLIDO correcto", txtApellido);
	                }
	            } else {
	                error("Ingrese un NOMBRE correcto", txtNombreDocente);
	            }
	        } else {
	            error("El código " + codigo + " no existe", txtCodigo);
	        }
	    } catch (Exception e) {
	        error("Ingrese un CÓDIGO correcto", txtCodigo);
	    }
	}
		
		
		
	// Método ELIMINAR
	void eliminarDocente() {
	    try {
	        int codigo = leerCodigo();
	        Docente x = ad.buscar(codigo);

	        if (x != null) {
	            // Mostrar los datos correspondientes
	            mostrarDatosDocente(x);
	        } else {
	            error("El código " + codigo + " no existe", txtCodigo);
	        }

	    } catch (Exception e) {
	        error("Ingrese CÓDIGO correcto", txtCodigo);
	    }
	}

	void mostrarDatosDocente(Docente docente) {
	    String mensaje = "Datos de Docente a eliminar:\n" +
	            "Código de Docente: " + docente.getCodigoDocente() + "\n" +
	            "Nombre            : " + docente.getNombre() + "\n" +
	            "Apellido          : " + docente.getApellido() + "\n" +
	            "Categoría         : " + docente.getCategoria() + "\n" +
	            "Teléfono          : " + docente.getTelefono() + "\n" +
	            "DNI               : " + docente.getDni() + "\n";

	    // Mostrar el mensaje con los datos
	    int confirmacion = confirmar(mensaje + "¿Está seguro de eliminar Datos de Docente?");

	    // Si elige "Sí", realizar la operación de eliminar
	    if (confirmacion == 0) {
	        ad.eliminar(docente);
	        listar();
	        limpiarCampos();
	        btnOK.setEnabled(false);
	    } else {
	        btnOK.setEnabled(true);
	    }
	}
		
		
		void limpiarCampos() {
		    // Limpiar los campos que deseas al presionar el botón OK
		    txtCodigo.setText("");
		    txtNombreDocente.setText("");
		    txtApellido.setText("");
		    txtCategoria.setText("");
		    txtTelefono.setText("");
		    txtDni.setText("");
		}
	
		
		
	//METODOS DE ACTIVACION Y DESCATIVACION DE BOTONES AL PULSARLOS 
		//  Métodos tipo void (con parámetros

		void habilitarEntradas(boolean sino) {
			txtNombreDocente.setEditable(sino);
			if (tipoOperaciones == INGRESAR)
			 	txtApellido.setEditable(sino);
			 	txtCategoria.setEditable(sino);
			 	txtTelefono.setEditable(sino);
			 	txtDni.setEditable(sino);
		}
		
		
		void habilitarBotones(boolean sino) {
			if (tipoOperaciones == INGRESAR)
				btnOK.setEnabled(!sino);
			else {
				btnBuscar.setEnabled(!sino);
				btnOK.setEnabled(false);
			}	
			btnIngresar.setEnabled(sino);
			btnConsultar.setEnabled(sino);
			btnModificar.setEnabled(sino);
			btnEliminar.setEnabled(sino);
			btnRegresar.setEnabled(!sino);		
		}
		
		
		void mensaje(String s) {
			JOptionPane.showMessageDialog(this, s, "Información", 0);
		}
		void error(String s, JTextField txt) {
			mensaje(s);
			txt.setText("");
			txt.requestFocus();
		}
		
	
		//  Métodos que retornan valor (sin parámetros)
		int leerCodigo() {
			return Integer.parseInt(txtCodigo.getText().trim());
		}
		
		String leerNombre() {
			return txtNombreDocente.getText().trim();
		}	
		
		String leerApellido() {
			return txtApellido.getText().trim();
		}
		
		String leerCategoria() {
			return txtCategoria.getText().trim();
		}
		
		String leerTelefono() {
			return txtTelefono.getText().trim();
		}
		
		String leerDni() {
			return txtDni.getText().trim();
		}
		
		
		//  Métodos que retornan valor (con parámetros)
		int anchoColumna(int porcentaje) {
			return porcentaje * scrollPane.getWidth() / 100;
		}
		
		double ajustar(double numero) {
			return (int)(numero * 10) / 10.0;
		}
		int confirmar(String s) {
			return JOptionPane.showConfirmDialog(this, s, "Alerta", 0, 1, null);
		}

