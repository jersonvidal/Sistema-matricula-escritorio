	private void cargarCursosEnComboBox() {
	    cboCurso.removeAllItems();
	
	    for (int i = 0; i < ac.tamanio(); i++) {
	        Curso curso = ac.obtener(i);
	        cboCurso.addItem(String.valueOf(curso.getCodigoCurso())); // Agregar el código del curso al JComboBox
	    }
	}
	
	
	
	
	
