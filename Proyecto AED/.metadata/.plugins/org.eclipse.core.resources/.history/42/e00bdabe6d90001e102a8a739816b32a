	public void actionPerformed(ActionEvent e) {
		if (e.getSource() == btnBuscar) {
			actionPerformedBtnBuscar(e);
		}
		if (e.getSource() == btnRetiroParcial) {
			actionPerformedBtnRetiroParcial(e);
		}
		if (e.getSource() == btnRetiroTotal) {
			actionPerformedBtnRetiroTotal(e);
		}
	}
	
	ArregloAlumno al = new ArregloAlumno();
	ArregloCurso ac = new ArregloCurso();
	
	protected void actionPerformedBtnBuscar(ActionEvent e) {
	    String codigoAlumno = txtCodigo.getText();
	    Alumno alumnoEncontrado = al.buscar(Integer.parseInt(codigoAlumno));

	    if (alumnoEncontrado != null) {
	        // Lógica para cargar los cursos disponibles para este alumno
	        // Aquí deberías obtener los cursos del ArregloCurso (ac) y cargarlos en el JComboBox cboCurso
	        if (btnRetiroParcial.isSelected()) {
	            cargarCursosDisponiblesParaAlumnoParcial(alumnoEncontrado);
	        } else if (btnRetiroTotal.isSelected()) {
	            cargarCursosDisponiblesParaAlumnoTotal(alumnoEncontrado);
	        }
	        cboCurso.setEnabled(true);
	    } else {
	        // Si no se encuentra el alumno, se muestra un mensaje en el JTextArea
	        textArea.setText("Alumno no encontrado");
	        cboCurso.setEnabled(false);
	    }
	}
	
	
	private void cargarCursosDisponiblesParaAlumnoParcial(Alumno alumno) {
	    // Lógica específica para cargar cursos disponibles para retiro parcial
	    // Puedes adaptar según tus necesidades
	    cboCurso.removeAllItems(); // Limpiamos los elementos actuales del JComboBox

	    // Aquí, podrías recorrer el arreglo de cursos y agregarlos al JComboBox
	    for (int i = 0; i < ac.tamanio(); i++) {
	        Curso curso = ac.obtener(i);
	        // Lógica para determinar si el curso está disponible para el alumno en retiro parcial
	        // Por ejemplo, podrías verificar si el alumno cumple con algún requisito para tomar el curso
	        // Y si cumple, agregarlo al JComboBox
	        cboCurso.addItem(curso.getAsignatura()); // Agregar el nombre del curso al JComboBox
	    }
	}
	
