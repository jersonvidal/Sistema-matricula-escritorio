package gui;

import java.awt.EventQueue;

import java.awt.Toolkit;

import javax.swing.JButton;
import javax.swing.JDialog;
import javax.swing.JLabel;
import javax.swing.JOptionPane;
import javax.swing.JTextField;

import arreglos.ArregloAsignacionDocente;
import arreglos.ArregloCurso;
import arreglos.ArregloDocente;
import clases.AsignacionDocente;
import clases.Curso;
import clases.Docente;

import javax.swing.JScrollPane;
import javax.swing.JTextArea;
import java.awt.event.ActionListener;
import java.awt.event.ActionEvent;

public class ReporteDocente extends JDialog implements ActionListener {

    private static final long serialVersionUID = 1L;
    private JLabel lblCodigoDocente;
    private JTextField txtCodigoDocente;
    private JButton btnBorrar;
    private JButton btnBuscar;
    private JScrollPane scrollPane;
    private JTextArea txtResultado;

    // Declaración global
    ArregloDocente ad = new ArregloDocente();
    ArregloAsignacionDocente aa = new ArregloAsignacionDocente();
    ArregloCurso ac = new ArregloCurso();

    public static void main(String[] args) {
        EventQueue.invokeLater(new Runnable() {
            public void run() {
                try {
                    ReporteDocente dialog = new ReporteDocente();
                    dialog.setDefaultCloseOperation(JDialog.DISPOSE_ON_CLOSE);
                    dialog.setVisible(true);
                } catch (Exception e) {
                    e.printStackTrace();
                }
            }
        });
    }

    public ReporteDocente() {
        setIconImage(Toolkit.getDefaultToolkit().getImage("C:\\\\Users\\\\User\\\\Desktop\\\\AED_Proyecto_Grupo_1\\cibertec.png"));

        setTitle("Reporte | Docente");
        setBounds(100, 100, 500, 350);
        getContentPane().setLayout(null);

        lblCodigoDocente = new JLabel("C\u00F3digo");
        lblCodigoDocente.setBounds(10, 11, 80, 23);
        getContentPane().add(lblCodigoDocente);

        txtCodigoDocente = new JTextField();
        txtCodigoDocente.setColumns(10);
        txtCodigoDocente.setBounds(71, 11, 92, 23);
        getContentPane().add(txtCodigoDocente);

        btnBuscar = new JButton("Buscar");
        btnBuscar.addActionListener(this);
        btnBuscar.setBounds(166, 11, 101, 23);
        getContentPane().add(btnBuscar);

        btnBorrar = new JButton("Borrar");
        btnBorrar.addActionListener(this);
        btnBorrar.setBounds(354, 11, 120, 23);
        getContentPane().add(btnBorrar);

        scrollPane = new JScrollPane();
        scrollPane.setBounds(10, 45, 464, 255);
        getContentPane().add(scrollPane);

        txtResultado = new JTextArea();
        scrollPane.setViewportView(txtResultado);
    }

    public void actionPerformed(ActionEvent e) {
        if (e.getSource() == btnBuscar) {
            actionPerformedBtnBuscar(e);
        }
        if (e.getSource() == btnBorrar) {
            actionPerformedBtnBorrar(e);
        }
    }

    protected void actionPerformedBtnBuscar(ActionEvent e) {
        listar();
    }

    protected void actionPerformedBtnBorrar(ActionEvent e) {
        txtResultado.setText("");
    }

    // Métodos tipo void (sin parametros)
    void imprimir() {
        imprimir("");
    }

    void listar() {
        try {
            int codigoDocente = leerCodigoDocente();

            // Variable para verificar si hay asignaciones
            boolean asignacionesEncontradas = false;

            // Buscar asignaciones para el docente
            for (int i = 0; i < aa.tamanio(); i++) {
                AsignacionDocente asignacion = aa.obtener(i);
                if (asignacion.getCodigoDocente() == codigoDocente) {
                    Curso curso = ac.buscar(asignacion.getCodigoCurso());
                    if (curso != null) {
                        imprimir("Código de Curso: " + curso.getCodigoCurso());
                        imprimir("Asignatura: " + curso.getAsignatura());
                        imprimir("-----");
                        // Se encontraron asignaciones
                        asignacionesEncontradas = true;
                    }
                }
            }

            // Mostrar datos del docente si se encontraron asignaciones
            if (asignacionesEncontradas) {
                // Mostrar datos del docente
                Docente docente = ad.buscar(codigoDocente);
                if (docente != null) {
                    imprimir("Datos del Docente:");
                    imprimir("Código: " + docente.getCodigoDocente());
                    imprimir("Nombre: " + docente.getNombre());
                    imprimir("Apellido: " + docente.getApellido());
                    imprimir("Teléfono: " + docente.getTelefono());
                    imprimir("DNI: " + docente.getDni());
                    imprimir("-----");
                }
            } else {
                // Mostrar mensaje si no hay asignaciones
                imprimir("Docente sin asignación de curso.");
            }
        } catch (NumberFormatException ex) {
            error("Ingrese un Código de Docente válido", txtCodigoDocente);
        }
    }

    // Métodos tipo void (con parametros)
    void imprimir(String s) {
        txtResultado.append(s + "\n");
    }

    void mensaje(String s) {
        JOptionPane.showMessageDialog(this, s, "Informacion", 0);
    }

    void error(String s, JTextField txt) {
        mensaje(s);
        txt.setText("");
        txt.requestFocus();
    }

    // Métodos que retornan valor (sin parametros)
    int leerCodigoDocente() {
        return Integer.parseInt(txtCodigoDocente.getText().trim());
    }
}
